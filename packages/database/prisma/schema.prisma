// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  ONCE
  SUBSCRIPTION
}

model Product {
  id            Int           @id @default(autoincrement())
  storeId       Int
  category      String
  name          String
  description   String
  image         String
  deliverables  String
  seller        String
  price         Int
  paymentMethod PaymentMethod
  purchases     Int
}

enum FileType {
  PHYSICAL
  PDF
  SPREADSHEET
  PRESENTATION
  IMAGES
  VIDEOS
  ZIP
}

model Deliverable {
  id           Int      @id @default(autoincrement())
  productId    Int
  title        String
  fileType     FileType
  fileSizeInKb Int
}

model Order {
  id          Int    @id @default(autoincrement())
  productId   Int
  buyer       String
  transaction String @unique
}

model Review {
  id        Int    @id @default(autoincrement())
  productId Int
  comment   String
  rating    Int
  reviewer  String
}

enum Font {
  INTER
  ROBOTO
  POPPINS
  MONTSERRAT
  OPEN_SANS
  LATO
  MULISH
  NUNITO
  RALEWAY
  SOURCE_SANS_PRO
}

enum ButtonShape {
  ROUNDED
  SQUARE
  PILL
}

enum ButtonStyle {
  FILLED
  OUTLINE
}

enum CardShadow {
  NONE
  LIGHT
  MEDIUM
  HIGH
}

enum TextStyle {
  THIN
  EXTRA_LIGHT
  LIGHT
  NORMAL
  SEMI_BOLD
  BOLD
  EXTRA_BOLD
  BLACK
}

enum HeaderLayout {
  CENTERED_COLUMN_WISE
  CENTERED_ROW_WISE
  JUSTIFY_BETWEEN
}

enum HeroBackgroundStyle {
  IMAGE
  IMAGE_DARKENED
  IMAGE_CLOUDED
  IMAGE_BLURRED_LIGHT
  IMAGE_BLURRED_MEDIUM
  IMAGE_BLURRED_HEAVY
  COLOR
  COLOR_OUTLINE_THIN
  COLOR_OUTLINE_NORMAL
  COLOR_OUTLINE_SEMI_BOLD
  COLOR_OUTLINE_BOLD
  COLOR_OUTLINE_EXTRA_BOLD
  COLOR_OUTLINE_BLACK
}

model Store {
  id     Int    @id @default(autoincrement())
  seller String

  name        String
  description String

  logo             String
  logoText         String
  logoTextFont     Font
  logoTextFontSize Int
  logoTextStyle    TextStyle

  headerLayout HeaderLayout

  heroTitle         String
  heroTitleColor    String
  heroTitleFont     Font
  heroTitleFontSize Int
  heroTitleStyle    TextStyle

  heroDescription         String
  heroDescriptionColor    String
  heroDescriptionFont     Font
  heroDescriptionFontSize Int
  heroDescriptionStyle    TextStyle

  heroHeight           Int
  heroBackgroundColor  String
  heroBackgroundRadius Int
  heroBackgroundStyle  HeroBackgroundStyle
  heroCover            String

  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String

  headingFont Font
  bodyFont    Font

  buttonShape ButtonShape
  buttonStyle ButtonStyle

  productGridRows    Int
  productGridColumns Int

  contentSpacing   Int
  cardBorderRadius Int
  cardShadow       CardShadow

  categories Int
}

model Category {
  id      Int    @id @default(autoincrement())
  storeId Int
  name    String
}

enum Gender {
  MALE
  FEMALE
}

model User {
  wallet    String @id @unique
  name      String
  photo     String
  gender    Gender
  bio       String
  location  String
  email     String @unique
  phone     String @unique
  instagram String @unique
  facebook  String @unique
  x         String @unique
  linkedin  String @unique
  whatsapp  String @unique
}

model Message {
  id       Int      @id @default(autoincrement())
  customer String
  seller   String
  message  String
  datetime DateTime
}
