// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  ONCE
  SUBSCRIPTION
}

model Product {
  id            Int           @id @default(autoincrement())
  store         Store         @relation(fields: [storeId], references: [id])
  storeId       Int
  category      Category      @relation(fields: [categoryId], references: [id])
  categoryId    Int
  name          String
  description   String
  image         String
  seller        User          @relation(fields: [sellerId], references: [wallet])
  sellerId      String        @unique
  price         Int
  paymentMethod PaymentMethod
  purchases     Int
  deliverables  Deliverable[]
  orders        Order[]
  review        Review[]
}

enum FileType {
  PHYSICAL
  PDF
  SPREADSHEET
  PRESENTATION
  IMAGES
  VIDEOS
  ZIP
}

model Deliverable {
  id           Int      @id @default(autoincrement())
  product      Product  @relation(fields: [productId], references: [id])
  productId    Int
  title        String
  fileType     FileType
  fileSizeInKb Int
}

model Order {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  consumer    User    @relation(fields: [consumerId], references: [wallet])
  consumerId  String
  transaction String  @unique
}

model Review {
  id         Int     @id @default(autoincrement())
  product    Product @relation(fields: [productId], references: [id])
  productId  Int
  comment    String
  rating     Int
  reviewer   User    @relation(fields: [reviewerId], references: [wallet])
  reviewerId String
}

enum Font {
  INTER
  ROBOTO
  POPPINS
  MONTSERRAT
  OPEN_SANS
  LATO
  MULISH
  NUNITO
  RALEWAY
  SOURCE_SANS_PRO
}

enum ButtonShape {
  ROUNDED
  SQUARE
  PILL
}

enum ButtonStyle {
  FILLED
  OUTLINE
}

enum CardShadow {
  NONE
  LIGHT
  MEDIUM
  HIGH
}

enum TextStyle {
  THIN
  EXTRA_LIGHT
  LIGHT
  NORMAL
  SEMI_BOLD
  BOLD
  EXTRA_BOLD
  BLACK
}

enum HeaderLayout {
  CENTERED_COLUMN_WISE
  CENTERED_ROW_WISE
  JUSTIFY_BETWEEN
}

enum HeroBackgroundStyle {
  IMAGE
  IMAGE_DARKENED
  IMAGE_CLOUDED
  IMAGE_BLURRED_LIGHT
  IMAGE_BLURRED_MEDIUM
  IMAGE_BLURRED_HEAVY
  COLOR
  COLOR_OUTLINE_THIN
  COLOR_OUTLINE_NORMAL
  COLOR_OUTLINE_SEMI_BOLD
  COLOR_OUTLINE_BOLD
  COLOR_OUTLINE_EXTRA_BOLD
  COLOR_OUTLINE_BLACK
}

model Store {
  id       Int    @id @default(autoincrement())
  seller   User   @relation(fields: [sellerId], references: [wallet])
  sellerId String

  name        String
  description String

  logo             String
  logoText         String
  logoTextFont     Font
  logoTextFontSize Int
  logoTextStyle    TextStyle

  headerLayout HeaderLayout

  heroTitle         String
  heroTitleColor    String
  heroTitleFont     Font
  heroTitleFontSize Int
  heroTitleStyle    TextStyle

  heroDescription         String
  heroDescriptionColor    String
  heroDescriptionFont     Font
  heroDescriptionFontSize Int
  heroDescriptionStyle    TextStyle

  heroHeight           Int
  heroBackgroundColor  String
  heroBackgroundRadius Int
  heroBackgroundStyle  HeroBackgroundStyle
  heroCover            String

  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String

  headingFont Font
  bodyFont    Font

  buttonShape ButtonShape
  buttonStyle ButtonStyle

  productGridRows    Int
  productGridColumns Int

  contentSpacing   Int
  cardBorderRadius Int
  cardShadow       CardShadow

  products   Product[]
  categories Category[]
}

model Category {
  id       Int       @id @default(autoincrement())
  store    Store     @relation(fields: [storeId], references: [id])
  storeId  Int
  name     String
  products Product[]
}

enum Gender {
  MALE
  FEMALE
}

model User {
  wallet           String    @id @unique
  name             String
  photo            String
  gender           Gender
  bio              String
  location         String
  email            String    @unique
  phone            String    @unique
  instagram        String    @unique
  facebook         String    @unique
  x                String    @unique
  linkedin         String    @unique
  whatsapp         String    @unique
  product          Product?
  orders           Order[]
  reviews          Review[]
  stores           Store[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Message {
  id         Int      @id @default(autoincrement())
  sender     User     @relation("SentMessages", fields: [senderId], references: [wallet])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [wallet])
  receiverId String
  message    String
  datetime   DateTime
}
